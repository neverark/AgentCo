# Optional: same-origin proxy destination for the free AgentLedger service.
# The default endpoint is already set in vite.config.ts.
AGENTLEDGER_SERVICE_ORIGIN=https://agentledger-one.vercel.app

# Server-side Onchain OS Token API authentication. Keep actual values in .env
# locally or in your deployment provider's secret environment settings.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Local buyer flow for the OKX.AI Sniffer Risk Check. The provider endpoint is
# pinned in code to the OKX.AI listing for Agent 6149; these settings only bound
# quote preparation and select the seller's documented request method.
AGENTCO_PAID_CALL_LIMIT_CENTS=10
AGENTCO_SNIFFER_METHOD=GET
# Optional seller-field overrides, used only if the payment CLI quote does not
# declare missing fields or an input schema. Leave blank to require discovery.
AGENTCO_SNIFFER_CHAIN_PARAM=
AGENTCO_SNIFFER_TOKEN_PARAM=
